{
    "name": "anthony-brindley/design-pattern-implementor",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "AnthonyBrindley\\DesignPatternImplementor\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AnthonyBrindley\\DesignPatternImplementor\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Anthony Brindley",
            "email": "anthony@anthonybrindley.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "spatie/laravel-package-tools": "^1.16",
        "laravel/prompts": "^0.3.2"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AnthonyBrindley\\DesignPatternImplementor\\Providers\\DesignPatternImplementorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@php ./vendor/bin/pest $*"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "pestphp/pest": "^3.6",
        "orchestra/testbench": "^9.7"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}